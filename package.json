{
  "name": "logger-adapters",
  "version": "0.0.0",
  "private": true,
  "description": "Thin @pegma/spine Logger implementations for Application Insights, Cloudflare, Datadog, and multi-sink teeing.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b --pretty false && tsc -p tsconfig.test.json --pretty false",
    "clean": "tsc -b --clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release:check": "node scripts/release-packages.mjs check",
    "release:pack": "node scripts/release-packages.mjs pack",
    "release:publish": "node scripts/release-packages.mjs publish",
    "test": "pnpm run build && vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
